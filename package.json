{
  "name": "tabby-sftp-plus",
  "version": "2.3.1",
  "description": "SFTP+ 美观易用的文件管理插件，支持内置查看/编辑、拖拽操作、书签、路径记忆、传输记录、多语言等。 Beautiful SFTP file manager for Tabby with built-in view/edit, drag-and-drop, bookmarks, transfer logs, and i18n.",
  "keywords": [
    "tabby-plugin",
    "sftp",
    "file-manager",
    "ssh",
    "tabby"
  ],
  "main": "dist/index.js",
  "scripts": {
    "check-common": "node scripts/check-common-sync.mjs",
    "prebuild": "npm run check-common",
    "build": "webpack --progress --color && node scripts/copy-icons.mjs && node scripts/copy-sftp-manifest.mjs",
    "watch": "webpack --progress --color --watch",
    "use-in-tabby": "powershell -NoProfile -ExecutionPolicy Bypass -File ./use-in-tabby.ps1",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "author": "DD1024z",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/10D24D/Tabby-SFTP-Plus.git"
  },
  "homepage": "https://github.com/10D24D/Tabby-SFTP-Plus#readme",
  "bugs": {
    "url": "https://github.com/10D24D/Tabby-SFTP-Plus/issues"
  },
  "devDependencies": {
    "@angular/animations": "^9.1.13",
    "@angular/common": "^9.1.13",
    "@angular/core": "^9.1.13",
    "@angular/forms": "^9.1.13",
    "@angular/platform-browser": "^9.1.13",
    "@angular/platform-browser-dynamic": "^9.1.13",
    "@types/node": "^22.13.10",
    "@types/webpack-env": "^1.18.8",
    "apply-loader": "^2.0.0",
    "css-loader": "^7.1.2",
    "graceful-fs": "^4.2.11",
    "rxjs": "^6.6.7",
    "sass": "^1.86.0",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "tabby-core": "^1.0.163",
    "tabby-settings": "^1.0.163",
    "tabby-terminal": "^1.0.163",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.2",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  }
}
